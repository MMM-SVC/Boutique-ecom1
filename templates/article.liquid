{% block 'container', class: 'page-section' %}
  <article class="article prose">
    <div class="page-header page-header--center">
      {% assign date = article.published_at | time_tag: format: 'date' %}
      <p class="eyebrow">{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
      <h1>{{ article.title | escape }}</h1>
    </div>

    {% if article.image %}
      <div class="article__image">
        {{ article.image | image_url: width: 1600 | image_tag: widths: '750, 1100, 1600', sizes: '(min-width: 990px) 760px, 100vw' }}
      </div>
    {% endif %}

    <div class="rte">{{ article.content }}</div>

    {% if blog.comments_enabled? %}
      <h2>{{ 'blog.article_comments' | t }}</h2>

      <div id="comments" class="comments">
        {% paginate article.comments by 10 %}
          {% for comment in article.comments %}
            <div class="comment">
              <p class="comment__author">{{ comment.author | escape }}</p>
              <p class="eyebrow">{{- comment.created_at | time_tag: format: 'date' -}}</p>
              <div class="rte">{{ comment.content }}</div>
            </div>
          {% endfor %}

          {{ paginate | default_pagination: anchor: 'comments' }}
        {% endpaginate %}
      </div>

      {% form 'new_comment', article, class: 'comment-form' %}
        <h2>{{ 'blog.comment_form_title' | t }}</h2>

        {{ form.errors | default_errors }}

        <div class="field">
          <label for="author">{{ 'blog.comment_form_name' | t }}</label>
          <input type="text" name="comment[author]" id="author" value="{{ form.author }}" required>
        </div>

        <div class="field">
          <label for="email">{{ 'blog.comment_form_email' | t }}</label>
          <input type="email" name="comment[email]" id="email" value="{{ form.email }}" required>
        </div>

        <div class="field">
          <label for="body">{{ 'blog.comment_form_body' | t }}</label>
          <textarea name="comment[body]" id="body" rows="5" required>{{ form.body }}</textarea>
        </div>

        <button class="button" type="submit">{{ 'blog.comment_form_submit' | t }}</button>
      {% endform %}
    {% endif %}
  </article>
{% endblock %}
