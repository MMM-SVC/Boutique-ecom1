{% block 'container', class: 'page-section' %}
  <div class="page-header page-header--center">
    <h1>{{ 'collections.title' | t }}</h1>
  </div>

  <ul class="collection-grid">
    {% for collection in collections %}
      <li>
        <a class="collection-card" href="{{ collection.url }}">
          <div class="collection-card__media">
            {% if collection.featured_image %}
              {{
                collection.featured_image
                | image_url: width: 900
                | image_tag: loading: 'lazy', widths: '450, 600, 900', sizes: '(min-width: 990px) 33vw, 50vw', alt: ''
              }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          <div class="collection-card__content">
            <h2 class="collection-card__title">{{ collection.title | escape }}</h2>
            <p>{{ 'collections.product_count' | t: count: collection.products_count }}</p>
          </div>
        </a>
      </li>
    {% endfor %}
  </ul>
{% endblock %}
