{% block 'container', class: 'page-section' %}
  <div class="page-header">
    <p class="eyebrow">{{ 'collections.eyebrow' | t }}</p>
    <h1>{{ collection.title | escape }}</h1>
    {% if collection.description != blank %}
      <div class="page-header__description rte">{{ collection.description }}</div>
    {% endif %}
  </div>

  {% paginate collection.products by 24 %}
    <div class="collection-toolbar">
      <p>{{ 'collections.product_count' | t: count: collection.products_count }}</p>

      <form class="collection-sort" method="get" action="{{ collection.url }}" data-sort-form>
        <label for="SortBy">{{ 'collections.sort_by' | t }}</label>
        <select id="SortBy" name="sort_by">
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          {% for option in collection.sort_options %}
            <option
              value="{{ option.value | escape }}"
              {% if option.value == sort_by %}
                selected
              {% endif %}
            >
              {{ option.name | escape }}
            </option>
          {% endfor %}
        </select>
        <button type="submit" class="button button--small" data-sort-submit>{{ 'collections.apply' | t }}</button>
      </form>
    </div>

    {% if collection.products.size > 0 %}
      <ul class="product-grid product-grid--4">
        {% for product in collection.products %}
          {%- liquid
            assign eager = false
            if forloop.index <= 4
              assign eager = true
            endif
          -%}
          <li>{% render 'product-card', product: product, eager: eager %}</li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="empty-state">{{ 'collections.empty' | t }}</p>
    {% endif %}

    {% if paginate.pages > 1 %}
      <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
        {%- liquid
          assign previous_label = 'general.previous' | t
          assign next_label = 'general.next' | t
        -%}
        {{ paginate | default_pagination: previous: previous_label, next: next_label }}
      </nav>
    {% endif %}
  {% endpaginate %}

  <script src="{{ 'collection.js' | asset_url }}" defer></script>
{% endblock %}
