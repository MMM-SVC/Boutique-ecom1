{% block 'container', class: 'page-section' %}
  <div class="page-header page-header--center">
    <h1>{{ 'search.title' | t }}</h1>

    <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="SearchInput">{{ 'search.placeholder' | t }}</label>
      <input
        id="SearchInput"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button class="button" type="submit">{{ 'search.submit' | t }}</button>
    </form>

    {% if search.performed %}
      {% if search.results_count == 0 %}
        <p>{{ 'search.no_results_html' | t: terms: search.terms }}</p>
      {% else %}
        <p>{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>
      {% endif %}
    {% endif %}
  </div>

  {% if search.performed and search.results_count > 0 %}
    {% paginate search.results by 24 %}
      <ul class="product-grid product-grid--4">
        {% for result in search.results %}
          <li>
            {% if result.object_type == 'product' %}
              {% render 'product-card', product: result %}
            {% else %}
              <article class="search-result">
                <p class="eyebrow">
                  {%- if result.object_type == 'article' -%}
                    {{ 'search.article' | t }}
                  {%- else -%}
                    {{ 'search.page' | t }}
                  {%- endif -%}
                </p>
                <h3 class="product-card__title">{{ result.title | escape | link_to: result.url }}</h3>
                <p>{{ result.content | strip_html | truncatewords: 20 }}</p>
              </article>
            {% endif %}
          </li>
        {% endfor %}
      </ul>

      {% if paginate.pages > 1 %}
        <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
          {%- liquid
            assign previous_label = 'general.previous' | t
            assign next_label = 'general.next' | t
          -%}
          {{ paginate | default_pagination: previous: previous_label, next: next_label }}
        </nav>
      {% endif %}
    {% endpaginate %}
  {% endif %}
{% endblock %}
