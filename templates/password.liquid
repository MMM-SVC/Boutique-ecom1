{% layout 'password' %}

{% block 'container', alignment: 'center', class: 'password-page' %}
  <div class="password">
    <p class="eyebrow">{{ shop.name | escape }}</p>
    <h1>{{ 'password.title' | t }}</h1>

    {% if shop.password_message %}
      <p>{{ shop.password_message }}</p>
    {% endif %}

    {% form 'storefront_password', class: 'password__form' %}
      {% if form.errors %}
        {{ form.errors | default_errors }}
      {% endif %}

      <label class="visually-hidden" for="password-input">
        {{ 'password.password' | t }}
      </label>

      <input type="password" name="password" id="password-input" placeholder="{{ 'password.password' | t }}">

      <button class="button" type="submit">
        {{ 'password.enter' | t }}
      </button>
    {% endform %}
  </div>
{% endblock %}
