[
  {
    "name": "theme_info",
    "theme_name": "Maison Skeleton",
    "theme_version": "1.0.0",
    "theme_author": "Boutique",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:labels.logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "t:labels.logo_width",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon"
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FAF7F2",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "background_secondary_color",
        "default": "#F1EBE1",
        "label": "t:labels.background_secondary"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#1A1A1A",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#B8975A",
        "label": "t:labels.accent"
      },
      {
        "type": "color",
        "id": "button_color",
        "default": "#1A1A1A",
        "label": "t:labels.button_background"
      },
      {
        "type": "color",
        "id": "button_text_color",
        "default": "#FAF7F2",
        "label": "t:labels.button_text"
      },
      {
        "type": "color",
        "id": "sale_color",
        "default": "#8C3B2E",
        "label": "t:labels.sale"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "playfair_display_n4",
        "label": "t:labels.heading_font"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:labels.body_font"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "t:labels.heading_scale",
        "default": 100
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      },
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "label": "t:labels.button_corner_radius",
        "default": 0
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 0
      }
    ]
  },
  {
    "name": "t:general.products",
    "settings": [
      {
        "type": "select",
        "id": "product_image_ratio",
        "label": "t:labels.product_image_ratio",
        "options": [
          {
            "value": "1 / 1",
            "label": "t:options.ratio.square"
          },
          {
            "value": "4 / 5",
            "label": "t:options.ratio.portrait"
          },
          {
            "value": "2 / 3",
            "label": "t:options.ratio.tall"
          }
        ],
        "default": "4 / 5"
      },
      {
        "type": "checkbox",
        "id": "show_secondary_image",
        "label": "t:labels.show_secondary_image",
        "default": true
      }
    ]
  },
  {
    "name": "t:general.cart",
    "settings": [
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "t:labels.free_shipping_threshold",
        "info": "t:info.free_shipping_threshold",
        "default": 60
      },
      {
        "type": "checkbox",
        "id": "show_cart_note",
        "label": "t:labels.show_cart_note",
        "default": true
      }
    ]
  },
  {
    "name": "t:general.social",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram",
        "label": "t:labels.social_instagram"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "t:labels.social_facebook"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "t:labels.social_tiktok"
      },
      {
        "type": "url",
        "id": "social_pinterest",
        "label": "t:labels.social_pinterest"
      }
    ]
  }
]
