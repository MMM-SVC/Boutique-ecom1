{% doc %}
  Brand story: an image beside a heading, text and optional button. Image
  side and colors are editable; empty texts fall back to translated defaults.

  @param {string} [content] - Optional extra markup rendered inside the block. Usually left empty.

  @example
  {% block 'image-with-text' %}{% endblock %}
{% enddoc %}

{%- liquid
  assign eyebrow = 'home.story.eyebrow' | t
  if block.settings.eyebrow != blank
    assign eyebrow = block.settings.eyebrow
  endif

  assign heading = 'home.story.heading' | t
  if block.settings.heading != blank
    assign heading = block.settings.heading
  endif

  assign text = 'home.story.text' | t
  if block.settings.text != blank
    assign text = block.settings.text
  endif

  assign button_label = 'home.story.button' | t
  if block.settings.button_label != blank
    assign button_label = block.settings.button_label
  endif
-%}

<div
  class="image-with-text band band--{{ block.settings.color_scheme }} full-width image-with-text--{{ block.settings.image_position }}"
  {{ block.shopify_attributes }}
>
  <div class="band__inner image-with-text__grid">
    <div class="image-with-text__media">
      {% if block.settings.image %}
        {{
          block.settings.image
          | image_url: width: 1600
          | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw'
        }}
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>
    <div class="image-with-text__content">
      <p class="eyebrow">{{ eyebrow | escape }}</p>
      <h2>{{ heading | escape }}</h2>
      <p class="image-with-text__text">{{ text | escape | newline_to_br }}</p>
      {% if block.settings.button_link != blank %}
        <a class="button button--outline" href="{{ block.settings.button_link }}">{{ button_label | escape }}</a>
      {% endif %}
      {{ content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:general.image_with_text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:labels.image_position",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "options": [
        { "value": "default", "label": "t:options.color_scheme.default" },
        { "value": "secondary", "label": "t:options.color_scheme.secondary" },
        { "value": "inverse", "label": "t:options.color_scheme.inverse" }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "info": "t:info.default_text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.default_text"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.text",
      "info": "t:info.default_text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "info": "t:info.default_text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    }
  ]
}
{% endschema %}
