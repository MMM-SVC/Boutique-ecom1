{% doc %}
  Full-width hero banner with a background image (desktop + optional mobile
  image), overlay, eyebrow, heading, text and up to two buttons. Every text is
  editable in the theme editor; empty fields fall back to translated defaults.

  @param {string} [content] - Optional extra markup rendered inside the block. Usually left empty.

  @example
  {% block 'hero' %}{% endblock %}
{% enddoc %}

{%- liquid
  assign eyebrow = 'home.hero.eyebrow' | t
  if block.settings.eyebrow != blank
    assign eyebrow = block.settings.eyebrow
  endif

  assign heading = 'home.hero.heading' | t
  if block.settings.heading != blank
    assign heading = block.settings.heading
  endif

  assign text = 'home.hero.text' | t
  if block.settings.text != blank
    assign text = block.settings.text
  endif

  assign button_label = 'home.hero.button' | t
  if block.settings.button_label != blank
    assign button_label = block.settings.button_label
  endif
  assign button_link = block.settings.button_link | default: routes.all_products_collection_url

  assign secondary_label = 'home.hero.secondary_button' | t
  if block.settings.secondary_button_label != blank
    assign secondary_label = block.settings.secondary_button_label
  endif
-%}

<div
  class="hero full-width hero--{{ block.settings.height }} hero--{{ block.settings.content_position }}"
  style="--overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"
  {{ block.shopify_attributes }}
>
  <div class="hero__media">
    {% if block.settings.image %}
      {%- liquid
        assign desktop_class = 'hero__image'
        if block.settings.image_mobile
          assign desktop_class = 'hero__image hero__image--desktop'
        endif
      -%}
      {{
        block.settings.image
        | image_url: width: 3000
        | image_tag:
          class: desktop_class,
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 2000, 3000',
          sizes: '100vw'
      }}
      {% if block.settings.image_mobile %}
        {{
          block.settings.image_mobile
          | image_url: width: 1500
          | image_tag:
            class: 'hero__image hero__image--mobile',
            loading: 'eager',
            widths: '500, 750, 1100, 1500',
            sizes: '100vw'
        }}
      {% endif %}
    {% else %}
      <div class="hero__placeholder" aria-hidden="true"></div>
    {% endif %}
  </div>

  <div class="hero__content">
    <p class="eyebrow">{{ eyebrow | escape }}</p>
    <h1 class="hero__heading">{{ heading | escape }}</h1>
    <p class="hero__text">{{ text | escape }}</p>
    <div class="hero__buttons">
      <a class="button" href="{{ button_link }}">{{ button_label | escape }}</a>
      {% if block.settings.secondary_button_link != blank %}
        <a class="button button--outline" href="{{ block.settings.secondary_button_link }}">
          {{- secondary_label | escape -}}
        </a>
      {% endif %}
    </div>
    {{ content }}
  </div>
</div>

{% schema %}
{
  "name": "t:general.hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.hero_image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:labels.image_mobile"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "t:labels.overlay_opacity",
      "default": 25
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:labels.height",
      "options": [
        {
          "value": "medium",
          "label": "t:options.size.medium"
        },
        {
          "value": "large",
          "label": "t:options.size.large"
        },
        {
          "value": "full",
          "label": "t:options.size.full"
        }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:labels.content_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "info": "t:info.default_text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.default_text"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.text",
      "info": "t:info.default_text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "info": "t:info.default_text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "t:labels.secondary_button_label",
      "info": "t:info.default_text"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "t:labels.secondary_button_link"
    }
  ]
}
{% endschema %}
