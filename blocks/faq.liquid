{% doc %}
  FAQ band: heading, intro text and a list of `faq-item` accordions passed
  as body content.

  @param {string} content - The `faq-item` blocks to display.

  @example
  {% block 'faq' %}
    {% block 'faq-item', default_question: 'home.faq.question_1', default_answer: 'home.faq.answer_1' %}{% endblock %}
  {% endblock %}
{% enddoc %}

{%- liquid
  assign eyebrow = 'home.faq.eyebrow' | t
  if block.settings.eyebrow != blank
    assign eyebrow = block.settings.eyebrow
  endif

  assign heading = 'home.faq.heading' | t
  if block.settings.heading != blank
    assign heading = block.settings.heading
  endif

  assign text = 'home.faq.text' | t
  if block.settings.text != blank
    assign text = block.settings.text
  endif
-%}

<div class="faq band band--{{ block.settings.color_scheme }} full-width" {{ block.shopify_attributes }}>
  <div class="band__inner faq__grid">
    <div class="faq__intro">
      <p class="eyebrow">{{ eyebrow | escape }}</p>
      <h2>{{ heading | escape }}</h2>
      <p>{{ text | escape }}</p>
      {% if block.settings.contact_link != blank %}
        <a class="link" href="{{ block.settings.contact_link }}">{{ 'home.faq.contact' | t }}</a>
      {% endif %}
    </div>
    <div class="faq__list">
      {{ content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:general.faq",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "options": [
        { "value": "default", "label": "t:options.color_scheme.default" },
        { "value": "secondary", "label": "t:options.color_scheme.secondary" },
        { "value": "inverse", "label": "t:options.color_scheme.inverse" }
      ],
      "default": "default"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "info": "t:info.default_text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.default_text"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.text",
      "info": "t:info.default_text"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "t:labels.contact_link"
    }
  ]
}
{% endschema %}
