{% doc %}
  Newsletter sign-up band. Subscribes the visitor as a customer with the
  `newsletter` tag (Shopify customer form) and shows a confirmation message.

  @param {string} [content] - Optional extra markup rendered inside the block. Usually left empty.

  @example
  {% block 'newsletter' %}{% endblock %}
{% enddoc %}

{%- liquid
  assign heading = 'newsletter.heading' | t
  if block.settings.heading != blank
    assign heading = block.settings.heading
  endif

  assign text = 'newsletter.text' | t
  if block.settings.text != blank
    assign text = block.settings.text
  endif
-%}

<div class="newsletter band band--{{ block.settings.color_scheme }} full-width" {{ block.shopify_attributes }}>
  <div class="band__inner newsletter__inner">
    <h2>{{ heading | escape }}</h2>
    <p>{{ text | escape }}</p>

    {% form 'customer', id: 'NewsletterForm', class: 'newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {% if form.posted_successfully? %}
        <p class="form-message form-message--success" role="status">{{ 'newsletter.success' | t }}</p>
      {% else %}
        {% if form.errors %}
          <p class="form-message form-message--error" role="alert">{{ 'newsletter.error' | t }}</p>
        {% endif %}
        <div class="newsletter__field">
          <label class="visually-hidden" for="NewsletterEmail">{{ 'newsletter.email' | t }}</label>
          <input
            id="NewsletterEmail"
            type="email"
            name="contact[email]"
            autocomplete="email"
            placeholder="{{ 'newsletter.email' | t }}"
            required
          >
          <button class="button" type="submit">{{ 'newsletter.submit' | t }}</button>
        </div>
      {% endif %}
    {% endform %}
    {{ content }}
  </div>
</div>

{% schema %}
{
  "name": "t:general.newsletter",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "options": [
        { "value": "default", "label": "t:options.color_scheme.default" },
        { "value": "secondary", "label": "t:options.color_scheme.secondary" },
        { "value": "inverse", "label": "t:options.color_scheme.inverse" }
      ],
      "default": "inverse"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.default_text"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.text",
      "info": "t:info.default_text"
    }
  ]
}
{% endschema %}
